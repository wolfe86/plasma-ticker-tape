<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
      http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>

  <group name="General">
    <!-- The watchlist, in display order, as a JSON array of
         {symbol, label, name, star}. `symbol` is the Yahoo symbol, `label` is
         what the tape prints, `star` puts it on the tape. The default is the
         seven the tape carried before settings existed, all starred. -->
    <entry name="symbols" type="String">
      <default>[{"symbol":"^GSPC","label":"S&amp;P 500","name":"S&amp;P 500","star":true},{"symbol":"^IXIC","label":"NASDAQ","name":"NASDAQ Composite","star":true},{"symbol":"^DJI","label":"DOW","name":"Dow Jones","star":true},{"symbol":"^SOX","label":"SOX","name":"PHLX Semiconductor","star":true},{"symbol":"^VIX","label":"VIX","name":"VIX","star":true},{"symbol":"DX-Y.NYB","label":"DXY","name":"US Dollar Index","star":true},{"symbol":"BTC-USD","label":"BTC","name":"Bitcoin","star":true}]</default>
    </entry>
    <entry name="scrollSpeed" type="Int">
      <label>Scroll speed in pixels per second</label>
      <default>30</default>
      <min>5</min>
      <max>150</max>
    </entry>
    <entry name="tapeWidth" type="Int">
      <label>Width of the tape in grid units</label>
      <default>12</default>
      <min>4</min>
      <max>60</max>
    </entry>
    <entry name="fearLine" type="Int">
      <label>VIX level at and above which it shows red</label>
      <default>20</default>
      <min>5</min>
      <max>90</max>
    </entry>
    <entry name="pollSeconds" type="Int">
      <label>Seconds between refreshes</label>
      <default>60</default>
      <min>15</min>
      <max>900</max>
    </entry>
    <!-- The screener tab (ScreenerEngine.qml). `screenerView` is the feed
         last shown: "gainers" (the default: the market's top gainers),
         "running" (small-cap Running Up) or "hod" (small-cap High of Day
         Momentum). The rest shape the two small-cap feeds. -->
    <!-- The screens, as a JSON array (shape in ui/screens.js). Empty means
         the starting three (Running Up, High of Day, Top Gainers), built
         from the older single-purpose settings below, which are otherwise
         no longer read by the engine. -->
    <entry name="screens" type="String">
      <default></default>
    </entry>
    <!-- The scorecards, as a JSON array (shape in ui/scorecards.js). Empty
         means the starting one, Small-cap momentum. -->
    <entry name="scorecards" type="String">
      <default></default>
    </entry>
    <!-- Long-term value: the smallest company considered, and whether the
         Deep Value screen and scorecard have been added to saved lists. -->
    <entry name="valueCapMin" type="Double">
      <default>2000000000</default>
    </entry>
    <!-- Score column: the coloured count only, without a dot per rule. -->
    <entry name="scoreCompact" type="Bool">
      <default>false</default>
    </entry>
    <entry name="rankedValueColumns" type="Bool">
      <default>false</default>
    </entry>
    <entry name="losersAdded" type="Bool">
      <default>false</default>
    </entry>
    <entry name="hunterAdded" type="Bool">
      <default>false</default>
    </entry>
    <entry name="valueAdded" type="Bool">
      <default>false</default>
    </entry>
    <entry name="screenerView" type="String">
      <default>gainers</default>
    </entry>
    <!-- Legacy: the price band the first scorecard and High of Day screen
         are built from, the first time only. -->
    <entry name="screenPriceMin" type="Double">
      <label>Lowest price in the starting price band</label>
      <default>1</default>
    </entry>
    <entry name="screenPriceMax" type="Double">
      <label>Highest price in the starting price band</label>
      <default>20</default>
    </entry>
    <!-- The pool: every stock trading poolMinVolume+ shares today or
         averaging poolMinAvg+ a day. Watched every passSeconds. -->
    <entry name="poolMinVolume" type="Int">
      <default>100000</default>
    </entry>
    <entry name="poolMinAvg" type="Int">
      <default>300000</default>
    </entry>
    <!-- Settings → Performance offers the same 10-120 s range. -->
    <entry name="passSeconds" type="Int">
      <default>30</default>
      <min>10</min>
      <max>120</max>
    </entry>
    <!-- Running Up: runPct% above the lowest price in the last runWindow
         minutes, for the starting Running Up screen. -->
    <entry name="runPct" type="Double">
      <default>3</default>
    </entry>
    <entry name="runWindow" type="Int">
      <default>2</default>
      <min>1</min>
      <max>10</max>
    </entry>
    <entry name="hodMinChange" type="Double">
      <label>High of Day: minimum gain on the day, in percent</label>
      <default>10</default>
    </entry>
    <entry name="hodMinRvol" type="Double">
      <label>High of Day: minimum relative volume for the day</label>
      <default>1</default>
    </entry>
    <!-- The screener table's column order and widths, set by dragging its
         headings: JSON {order: [keys], widths: {key: grid units}}. Empty is
         the default layout. -->
    <entry name="screenerLayout" type="String">
      <default></default>
    </entry>
    <!-- Per-screen sort set by clicking a heading: JSON {screen id: {key, asc}}. -->
    <entry name="screenerSort" type="String">
      <default></default>
    </entry>
    <!-- The theme detector (beta): off hides its column and detail tag and
         stops its tally. -->
    <!-- Alert sounds: the player command ("" = whichever is installed,
         %f = the file), and alert times in local time instead of New York's. -->
    <entry name="soundPlayer" type="String">
      <default></default>
    </entry>
    <entry name="timesLocal" type="Bool">
      <default>false</default>
    </entry>
    <!-- The Google News edition the detail card's fallback news uses. -->
    <entry name="newsLocale" type="String">
      <default>en-US</default>
    </entry>
    <!-- The tape's Themes entry (symbol "@themes" in Symbols): which theme
         readings put a ticker on the tape, how many at most, and whether
         the theme's name goes with it. -->
    <entry name="tapeThemeStatus" type="String">
      <default>hot</default>
    </entry>
    <entry name="tapeThemeMax" type="Int">
      <default>10</default>
    </entry>
    <!-- A theme ticker leaves the tape once it is this far (%) below its
         session high; the theme itself then holds the slot while strong. -->
    <entry name="tapeThemeDrop" type="Int">
      <default>20</default>
    </entry>
    <!-- Treat the last session's members (at their latest prices) as live:
         a weekend preview of the Themes entry, and a way to test it. -->
    <entry name="tapeThemePreview" type="Bool">
      <default>false</default>
    </entry>
    <!-- The 200-day EMA rule (Matt, 2026-10-24: below it a ticker is almost
         never tradable, theme or not). Tape: theme tickers must be above it.
         ShortHistory: a stock with under 200 sessions has no 200 EMA yet;
         true lets it through (tape and the screener filter alike). -->
    <entry name="tapeAbove200" type="Bool">
      <default>true</default>
    </entry>
    <entry name="ema200ShortHistory" type="Bool">
      <default>true</default>
    </entry>
    <!-- What marks a theme ticker on the tape: "name" (a heat-coloured dot
         and the theme's name), "icon" (the theme's glyph in its heat colour)
         or "both". -->
    <entry name="tapeThemeMark" type="String">
      <default>name</default>
    </entry>
    <entry name="themesOn" type="Bool">
      <default>true</default>
    </entry>
    <!-- Sectors (beta): the second layer under themes. Off hides the column
         and tag and stops the sector tally. Overrides: {"TICKER": "s-energy"}. -->
    <!-- Settings → Themes → Your themes / Your sectors (themes.js). Themes
         never saved ("") = the starter set; saved empty ("[]") = none.
         Empty sectors = none of your own. A theme's pinned tickers are
         {symbol, from}: pinned from that day ("" = always). -->
    <entry name="customThemes" type="String">
      <default></default>
    </entry>
    <entry name="customSectors" type="String">
      <default></default>
    </entry>
    <entry name="sectorsOn" type="Bool">
      <default>true</default>
    </entry>
    <entry name="sectorOverrides" type="String">
      <default></default>
    </entry>
    <!-- Overrides for themes.js `defaults`: JSON {ranPct, hotRan, liftX,
         bldX, keepDays, minHistory, window}. Anything absent keeps its
         built-in value. Keys from before 2026-10-24 (minMembers, hotFollow,
         coldTrips, burnWindow) are ignored. -->
    <entry name="themeTuning" type="String">
      <default></default>
    </entry>
    <!-- A theme that was hot is burnt (dead) after this many calendar days
         with no runner (Matt, 2026-10-24). -->
    <entry name="themeDeadDays" type="Int">
      <default>30</default>
      <min>1</min>
      <max>90</max>
    </entry>
    <!-- Sessions a stock stays on a theme after its headline last matched
         the theme's words (0 = only while it matches). -->
    <entry name="themeStickySessions" type="Int">
      <default>10</default>
      <min>0</min>
      <max>60</max>
    </entry>
    <!-- The theme icon's colour ramp: heat (grey/amber/red), market
         (grey/amber/green, keeping red for down) or violet. -->
    <!-- {theme id: {icon, keep}}: icon-theme names or file paths. -->
    <entry name="themeIcons" type="String">
      <default></default>
    </entry>
    <entry name="themeRamp" type="String">
      <default>heat</default>
    </entry>

    <!-- The Screener tab's tools row and legend: shown or folded away. -->
    <entry name="screenerTools" type="Bool">
      <default>true</default>
    </entry>
    <!-- The detail chart's style, for every range: candles, or a line. -->
    <!-- Chart overlays: the EMA lengths shown (comma-separated), VWAP, volume. -->
    <!-- Settings → Data → News sources: JSON array, see ui/newsfeeds.js. -->
    <!-- Settings → Performance. Defaults are the "Full" preset: every
         stock every pass, as the widget always ran. -->
    <entry name="perfPreset" type="String">
      <default>full</default>
    </entry>
    <entry name="smartPoll" type="Bool">
      <default>false</default>
    </entry>
    <entry name="smartRestMinutes" type="Int">
      <default>5</default>
    </entry>
    <entry name="poolMinutes" type="Int">
      <default>5</default>
    </entry>
    <entry name="poolClosedMinutes" type="Int">
      <default>5</default>
    </entry>
    <entry name="closedPassMinutes" type="Int">
      <default>15</default>
    </entry>
    <entry name="cryptoPassSeconds" type="Int">
      <default>30</default>
    </entry>
    <entry name="quoteFields" type="Bool">
      <default>true</default>
    </entry>
    <entry name="valueMinutes" type="Int">
      <default>2</default>
    </entry>
    <entry name="newsSources" type="String">
      <default></default>
    </entry>
    <entry name="newsPollSeconds" type="Int">
      <default>60</default>
    </entry>
    <!-- The built-in market desks (Seeking Alpha, MarketWatch, CNBC). -->
    <entry name="newsBuiltins" type="Bool">
      <default>true</default>
    </entry>
    <entry name="chartEmas" type="String">
      <default></default>
    </entry>
    <entry name="chartVwap" type="Bool">
      <default>true</default>
    </entry>
    <entry name="chartVolume" type="Bool">
      <default>true</default>
    </entry>
    <entry name="chartCandles" type="Bool">
      <default>true</default>
    </entry>
    <entry name="alertSound" type="Bool">
      <label>Alert sounds on (the pop-up's mute button)</label>
      <default>true</default>
    </entry>
    <!-- Each feed's sound, as a file path from ui/sounds.js; empty is none.
         Two different bells by default, so the feed can be told by ear. -->
    <!-- Legacy, 2026-10-22 only: where alerts were saved before they moved
         to the LocalStorage database. Read once to carry that day's alerts
         across, then emptied. -->
    <entry name="alertLog" type="String">
      <default></default>
    </entry>
    <entry name="runSound" type="String">
      <default>/usr/share/sounds/freedesktop/stereo/bell.oga</default>
    </entry>
    <entry name="hodSound" type="String">
      <default>/usr/share/sounds/ocean/stereo/bell-window-system.oga</default>
    </entry>
    <!-- Settings → Data: the scanner the bridge runs and what it is told.
         Passed to it as environment variables (code/scanner/settings.py).
         An empty scannerDir is the bundled code/scanner/ folder. -->
    <entry name="scannerDir" type="String">
      <default></default>
    </entry>
    <!-- The User-Agent SEC EDGAR requires: a name and a contact email.
         Empty turns the dilution and long-term value features off. -->
    <entry name="secContact" type="String">
      <default></default>
    </entry>
    <!-- Earnings calendar: every reporter worth this much or more is listed,
         plus tickers with a folder in researchDir and those in
         earningsTickers (space- or comma-separated). -->
    <entry name="earningsMinCap" type="Double">
      <default>40000000000</default>
    </entry>
    <entry name="researchDir" type="String">
      <default></default>
    </entry>
    <entry name="earningsTickers" type="String">
      <default></default>
    </entry>
    <!-- The Calendar tab's view: day | week | month. -->
    <entry name="calendarView" type="String">
      <default>week</default>
    </entry>
    <!-- News tab: show a picture beside each headline (the feed's own, else
         the article page's preview image, read from the top of the page). -->
    <entry name="newsImages" type="Bool">
      <default>true</default>
    </entry>
  </group>
</kcfg>
